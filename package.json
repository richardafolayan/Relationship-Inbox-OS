{
  "name": "relationship-inbox-os",
  "private": true,
  "version": "0.1.16",
  "main": "apps/desktop/main.cjs",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:generate && npm run db:push && npm run build --workspace @inbox-os/core && turbo run dev --parallel",
    "dev:fast": "turbo run dev --parallel",
    "install:student": "bash scripts/install-student-macos.sh",
    "uninstall:student": "bash scripts/uninstall-student-macos.sh",
    "start:student": "node scripts/start-student.mjs",
    "start:app": "node scripts/start-app.mjs",
    "start:desktop": "electron apps/desktop/main.cjs",
    "dev:desktop": "RIOS_DEV=1 electron apps/desktop/main.cjs",
    "build:macos-dmg": "node scripts/build-macos-dmg.mjs",
    "build:windows": "node scripts/build-windows-installer.mjs",
    "create:macos-app": "node scripts/create-macos-app-bundle.mjs",
    "doctor": "node scripts/doctor.mjs",
    "perf:interactions": "node scripts/performance/measure-interaction-latency.mjs",
    "perf:launcher": "node scripts/performance/measure-launcher-preparation.mjs",
    "perf:seed": "node scripts/performance/seed-interaction-fixture.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "fetch:whisper-model": "node scripts/fetch-whisper-model.mjs",
    "build:student-release": "node scripts/build-student-release.mjs",
    "publish:student-release": "node scripts/publish-student-release.mjs",
    "update:student": "node scripts/update-student.mjs",
    "build": "turbo run build",
    "lint": "npm run build --workspace @inbox-os/core && turbo run lint",
    "test": "npm run test:all",
    "test:all": "npm run build --workspace @inbox-os/core && npm run build --workspace @inbox-os/runner && node --import tsx --test tests/*.test.mjs",
    "audit:mobile": "node scripts/mobile-pilot-audit.mjs",
    "move-on": "npm run test:all",
    "db:generate": "prisma generate --schema packages/core/prisma/schema.prisma",
    "db:push": "DATABASE_URL=file:$(pwd)/data/inbox-os.sqlite prisma db push --schema packages/core/prisma/schema.prisma",
    "db:migrate": "DATABASE_URL=file:$(pwd)/data/inbox-os.sqlite prisma migrate dev --schema packages/core/prisma/schema.prisma",
    "dev:dashboard": "npm run dev --workspace @inbox-os/dashboard",
    "dev:runner": "npm run db:generate && npm run db:push && npm run build --workspace @inbox-os/core && npm run dev --workspace @inbox-os/runner",
    "scan": "npm run scan --workspace @inbox-os/runner",
    "connect:linkedin": "npm run connect:linkedin --workspace @inbox-os/runner",
    "test:selectors:linkedin": "npm run test:selectors:linkedin --workspace @inbox-os/runner",
    "linkedin:smoke": "npm run linkedin:smoke --workspace @inbox-os/runner",
    "repair:linkedin-threads": "npm run repair:linkedin-threads --workspace @inbox-os/runner",
    "db:reset:linkedin": "npm run db:reset:linkedin --workspace @inbox-os/runner",
    "cleanup:artifacts": "npm run cleanup:artifacts --workspace @inbox-os/runner",
    "seed:operator-profile": "npm run seed:operator-profile --workspace @inbox-os/runner"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "prisma": "^6.3.1"
  },
  "build": {
    "appId": "relationship-inbox-os",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      ".env.example",
      "package.json",
      "apps/desktop/**/*",
      "apps/dashboard/.next/**/*",
      "apps/dashboard/next.config.mjs",
      "apps/dashboard/package.json",
      "apps/dashboard/public/**/*",
      "apps/runner/dist/**/*",
      "apps/runner/package.json",
      "packages/core/dist/**/*",
      "packages/core/package.json",
      "packages/core/prisma/**/*",
      "packages/core/selectors/**/*",
      "scripts/start-app.mjs",
      "scripts/lib/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/windows-runtime/${arch}",
        "to": "runtime/node"
      },
      {
        "from": "node_modules/onnxruntime-node/bin/napi-v3/win32/x64",
        "to": "app/node_modules/onnxruntime-node/bin/napi-v3/win32/x64"
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": "app/node_modules/better-sqlite3",
        "filter": [
          "package.json",
          "lib/**/*",
          "build/Release/better_sqlite3.node"
        ]
      },
      {
        "from": "node_modules/next",
        "to": "app/node_modules/next"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
