OPENAI_API_KEY=
# Default: gpt-5-nano (cheapest GPT-5 family). Other valid choices in order
# of capability + price: gpt-5-mini, gpt-5, gpt-5.4-mini, gpt-5.4,
# gpt-4o-mini, gpt-4o. ai.ts adapts the request param shape per model
# (nano doesn't support top_p; reasoning_effort "none" is gpt-5.4-only).
OPENAI_MODEL=gpt-5-nano
# AI provider toggle. Valid values: "openai" (default), "glm", "gemini".
# The dashboard /settings page can override at runtime; this seeds the
# cold-start default.
AI_PROVIDER=openai
# Z.AI / BigModel credentials. Required only when AI_PROVIDER=glm or when
# the dashboard toggles to GLM. Free-tier flash models (glm-4.7-flash,
# glm-4.5-flash) are listed on the pricing page but not in /v4/models;
# pass the literal id to chat/completions.
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4
Z_AI_MODEL=glm-4.7-flash
# Google Gemini API. Required only when AI_PROVIDER=gemini or when the
# dashboard toggles to Gemini. Get a key from
# https://aistudio.google.com/apikey.
#
# Default model is gemma-4-31b-it. Gemma 4 ships with thinking traces ON
# by default, but Google's OpenAI-compat endpoint accepts
# `extra_body.google.thinking_config.thinking_level: "MINIMAL"` to
# suppress them — the runner spreads that flag at every Gemma call site
# automatically (services/ai.ts:geminiExtraBody). Other smoke-confirmed
# working ids: gemini-3-flash-preview. The smoke-test script at
# apps/runner/src/scripts/gemini-smoke.ts is the source of truth on
# value-space behaviour.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemma-4-31b-it
DATABASE_URL=file:./data/inbox-os.sqlite
RUNNER_PORT=4001
DASHBOARD_PORT=3100
# How the runner gets a browser session.
#   personal  - mirrors your real Chrome profile, so the runner reuses the
#               LinkedIn session you are already signed into. Recommended
#               for the student pilot (see docs/pilot/student-install-guide.md):
#               a real, signed-in Chrome profile is the gentlest path for
#               LinkedIn's automation detection.
#   isolated  - the runner opens its own clean browser and you sign in there.
#               Use this only as a fallback if personal Chrome mode cannot
#               be set up (e.g. you do not use Chrome).
BROWSER_PROFILE_MODE=personal
# Keep the headless browser OFF for the pilot — a visible (offscreen) Chrome
# looks far less like a bot. The Settings page has the toggle; leave it off.
PERSONAL_PROFILE_FALLBACK=error
PERSONAL_PROFILE_SYNC_MODE=smart
PERSONAL_PROFILE_MIRROR_ROOT=
# Personal Chrome profile (only used when BROWSER_PROFILE_MODE=personal).
# Leave blank to auto-detect from your home directory. To target a specific
# Chrome profile, set the user-data dir and either the profile directory
# ("Default", "Profile 1", "Person 1", ...) or the profile's display name.
PERSONAL_CHROME_USER_DATA_DIR=
PERSONAL_CHROME_PROFILE_DIRECTORY=Person 1
PERSONAL_CHROME_PROFILE_NAME=
CONNECT_OPERATION_TIMEOUT_MS=25000
CONNECT_OPERATION_TIMEOUT_MS_PERSONAL=90000
# Lowered from 200 to keep volume inside the noise floor of a real
# user checking their messages. Raise carefully and only if you're
# willing to trade detection risk for catch-up speed.
LINKEDIN_SCAN_MAX_THREADS=50
LINKEDIN_SCAN_STABLE_ITERATIONS=3
LINKEDIN_SCAN_SCROLL_WAIT_MS=1000
LINKEDIN_SCAN_MESSAGE_BACKFILL_ATTEMPTS=8
# Optional fallback creds. Persistent Chrome profile is the primary auth path;
# these only fire if the runner sees AUTH_REQUIRED and a >60s gap since the
# last attempt. Captcha / 2FA / wrong-creds surface as MANUAL_LOGIN_REQUIRED
# rather than retry loops. Leave both blank to disable the fallback entirely.
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
# Phase 2 profile-enrichment knobs. Visiting strangers' profiles to
# scrape posts/headline is the closest thing this app does to actual
# scraping and the most fingerprint-able activity it performs.
# Auto-enrichment is OFF by default — manual "research this person"
# triggers still work. Set ENRICH_AUTO_ENABLED=1 to re-enable the
# on-scan auto-enqueue + hourly background tick. Daily cap lowered
# from 40 to 10.
ENRICH_AUTO_ENABLED=
ENRICH_DAILY_CAP=10
ENRICH_PACE_MS=30000
ENRICH_BATCH_MAX=30
ENRICH_REFRESH_DAYS=30
LINKEDIN_DEV_SCAN_MAX_THREADS=
LINKEDIN_DEV_SCAN_MAX_OPENS=
LINKEDIN_DEV_SCAN_DISABLE_DEEP_SCROLL=0
LINKEDIN_DEV_DISABLE_AUTOSCAN=1
LINKEDIN_DEV_LOG_STAGE_HEADLINES=1
NEXT_PUBLIC_DISABLE_AUTOSCAN=1
NEXT_PUBLIC_LINKEDIN_DEV_DISABLE_AUTOSCAN=1
NEXT_PUBLIC_ENABLE_SCAN_FALLBACK=0
# Auto-scan active-hours window (local clock, 24h ints, end exclusive).
# Outside this window — and on weekends unless WEEKENDS is set — the
# dashboard auto-scan loop skips its tick. Matches a real person's
# usage pattern instead of a 24/7 bot. Defaults: 08:00-19:00 weekdays.
NEXT_PUBLIC_AUTO_SCAN_HOUR_START=8
NEXT_PUBLIC_AUTO_SCAN_HOUR_END=19
NEXT_PUBLIC_AUTO_SCAN_WEEKENDS=
# Pilot feedback intake. The in-app feedback modal posts a report to the
# local runner, which forwards it to a Google Apps Script webhook that
# writes a Google Sheets row and stores any screenshot in Google Drive.
# See docs/pilot/apps-script.md for the script and setup. All three are
# runner-side only — never exposed to the browser.
#
#   PILOT_FEEDBACK_WEBHOOK_URL - the Apps Script /exec URL reports POST to.
#                                Unset = the modal falls back to copy /
#                                the external form below.
#   PILOT_FEEDBACK_SECRET      - shared secret the Apps Script verifies.
#   PILOT_FEEDBACK_STATUS_URL  - optional; the Apps Script URL the "Recent
#                                reports" view reads (safe columns only).
PILOT_FEEDBACK_WEBHOOK_URL=
PILOT_FEEDBACK_SECRET=
PILOT_FEEDBACK_STATUS_URL=
# Optional external fallback form (e.g. a Google Form). Shown only if a
# submit fails, so a tester still has a way through. NEXT_PUBLIC_ because
# the dashboard reads it directly; it carries no secret.
NEXT_PUBLIC_FEEDBACK_FORM_URL=
# Version string shown in copied bug reports so a tester's report
# names the build they were on.
NEXT_PUBLIC_APP_VERSION=0.1.0
DEV_LOG=1
DEV_LOG_PII=0
