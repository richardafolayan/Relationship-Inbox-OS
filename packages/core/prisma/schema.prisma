generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlatformName {
  LINKEDIN
  INSTAGRAM
  TIKTOK
  // IMESSAGE landed first as a schema-only declaration on main (so prisma
  // could read existing iMessage rows without throwing
  // `Value 'IMESSAGE' not found in enum 'PlatformName'`). The matching
  // adapter dispatches iMessage operations against
  // services/platform-factory.ts. WHATSAPP follows the same pattern —
  // foundation enum lands first, full adapter follows in a follow-up
  // (see feat/whatsapp-phase-b on origin for the in-flight adapter).
  IMESSAGE
  WHATSAPP
}

enum PlatformStatus {
  CONNECTED
  NOT_CONNECTED
  DEGRADED
  ERROR
}

enum RiskLevel {
  GREEN
  AMBER
  RED
}

enum Direction {
  IN
  OUT
}

enum AuditStatus {
  OK
  FAIL
}

enum SendRequestStatus {
  SCHEDULED
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum EnrichmentJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Platform {
  id          String         @id @default(cuid())
  name        PlatformName   @unique
  status      PlatformStatus @default(NOT_CONNECTED)
  lastScanAt  DateTime?
  lastError   String?
  connectedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  @@map("platforms")
}

model Person {
  id          String   @id @default(cuid())
  displayName String
  // For platforms that don't expose a real name (iMessage stores phone
  // numbers / emails), we run a heuristic over outbound greetings ("Hi
  // Marianne") to guess one. Surfaced in the dashboard as a "Maybe …"
  // suggestion the operator can confirm into displayName, edit, or
  // reject. Cleared once the operator promotes or dismisses it.
  inferredName String?
  handle      String?
  platform    PlatformName
  profileUrl  String?
  // Provenance for profileUrl: "auto" when the row scanner inferred the URL
  // from a chat row's avatar/name anchor, "manual" when the operator pasted
  // it via the dashboard. Auto-discovery never overwrites a manual value.
  profileUrlSource String?
  // Hotlinked profile photo URL captured during scans (LinkedIn only today).
  // The platform signs these URLs and they expire, but every scan refreshes
  // the value, so the dashboard tolerates broken images by falling back to
  // the initials tile until the next scan rewrites the row.
  avatarUrl   String?
  notes       String?
  tagsJson    String?
  // Set by the enrichment queue when a profile-extraction job completes
  // successfully. Drives the periodic-refresh selector (re-enrich anything
  // older than ENRICH_REFRESH_DAYS that has had recent thread activity).
  enrichedAt              DateTime?
  // Last failure reason from the enrichment adapter (e.g. "private",
  // "not_found", "timeout", "auth_required"). Cleared on the next successful
  // run. Surfaced in the dashboard footer when present.
  enrichmentFailedReason  String?
  // Birthday sourced from the operator's macOS Contacts (AddressBook), kept
  // current by the birthday-sync service. Stored as zero-padded "MM-DD" so the
  // upcoming-birthdays lookup is a pure month/day comparison independent of
  // year. `birthYear` holds the four-digit year when the contact card carries
  // one (most do); null for year-less cards. Both stay null until a sync run
  // matches this Person to a contact by phone or email. The macOS Contacts
  // card is the source of truth; these are never edited from the dashboard.
  birthday                String?
  birthYear               Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  threads     Thread[]
  enrichment  PersonEnrichment?
  enrichmentJobs EnrichmentJob[]

  @@index([displayName])
  @@map("people")
}

model PersonEnrichment {
  id              String   @id @default(cuid())
  personId        String   @unique
  // Structured queryable fields. Nullable because LinkedIn profiles vary in
  // completeness and our parser fails sections soft.
  headline        String?
  about           String?
  location        String?
  currentCompany  String?
  currentRole     String?
  mutualCount     Int?
  // JSON columns (SQLite stores JSON as String). All optional. Keep a single
  // JSON blob per list rather than normalised tables: the lists are read as
  // a unit by the AI prompts and never queried by inner field.
  experienceJson    String?
  educationJson     String?
  skillsJson        String?
  servicesJson      String?
  licensesJson      String?
  recentPostsJson   String?
  recentCommentsJson String?
  recentReactionsJson String?
  mutualNamesJson   String?
  // Follower count from the profile header. Null when LinkedIn doesn't
  // expose it (Recruiter/limited profiles, or when the badge fails to parse).
  followersCount    Int?
  // Cached AI output, regenerated when the cache key (a hash over the
  // enrichment payload + the operator's self-profile hash) no longer matches.
  // Including the self-profile hash means a one-off self-refresh
  // automatically invalidates every dependent summary and starter set.
  summary           String?
  summaryCacheKey   String?
  startersJson      String?
  startersCacheKey  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("person_enrichments")
}

model EnrichmentJob {
  id            String              @id @default(cuid())
  personId      String
  status        EnrichmentJobStatus @default(PENDING)
  attempts      Int                 @default(0)
  // Earliest time the picker may run this job. Set when a failure schedules
  // an exponential retry, or when the queue defers because scan/send hold
  // the browser session.
  nextAttemptAt DateTime?
  lastError     String?
  // Why the job exists, for diagnostics + telemetry. Not used for routing.
  // "first_seen" — created from scan-queue when a Person row was first
  //   inserted. "manual" — operator clicked Refresh in the dashboard.
  //   "periodic" — background tick re-enriching a stale active contact.
  trigger       String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([personId])
  @@map("enrichment_jobs")
}

model Thread {
  id                String       @id @default(cuid())
  platform          PlatformName
  platformThreadId  String
  threadUrl         String?
  personId          String
  unreadCount       Int          @default(0)
  needsReply        Boolean      @default(false)
  lastMessagePreview String?
  lastMessageAt     DateTime?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  lastInboundHash   String?
  riskLevel         RiskLevel    @default(GREEN)
  slaDueAt          DateTime?
  riskReason        String?
  rollingSummary    String?
  whatTheyWant      String?
  openLoopsJson     String?
  // List of open-loop strings the operator has dismissed via the thread-pane
  // checkbox. Filtered out of the visible openLoops surface in the dashboard
  // so re-summarisation can still recompute openLoopsJson without re-showing
  // loops the operator has already handled.
  dismissedOpenLoopsJson String?
  toneNotesJson     String?
  // Set the first time we walk the thread's message list to the top and
  // persist every historical message. Subsequent scans only fetch the delta
  // (messages newer than `lastMessageAt`). Null means full-history backfill
  // hasn't run yet for this thread.
  firstFullBackfillAt DateTime?

  // WhatsApp group identity. v1 models groups via a single-Person hack: the
  // Thread points at a synthetic Person whose displayName equals groupName,
  // and per-message senders go on Message.senderName. A proper participants
  // table is queued as a follow-up. isGroup defaults false so existing rows
  // (LinkedIn / Instagram / TikTok) need no backfill.
  isGroup    Boolean  @default(false)
  groupName  String?
  // Stable platform-side group id (e.g. WhatsApp's `<id>@g.us` JID). Lets us
  // find the same group across re-scans even if groupName changes.
  groupId    String?

  // Cached AI-generated suggested replies. Regenerated only when the cache
  // key (a hash of the AI inputs: last-inbound text + timestamp + summary +
  // whatTheyWant + openLoops) no longer matches what's stored. Without this
  // every /data/thread fetch hits OpenAI even when the conversation hasn't
  // changed — a costly side effect of the dashboard's refresh-after-action
  // pattern (Mark done / Snooze / Save draft each call refresh()).
  suggestedRepliesJson      String?
  suggestedRepliesCacheKey  String?

  // Direction + text of the most-recent message in the thread, irrespective
  // of who sent it. lastMessagePreview historically only tracked the latest
  // INBOUND, so once the operator replied the inbox row preview was stale. These
  // are written by send.ts (on outbound) and scan-queue.ts (on persist of
  // any new message). The dashboard prefixes outbound previews with "You: "
  // matching LinkedIn's convention.
  lastMessageDirection Direction?
  lastMessageText      String?

  // Set when the operator archives a thread from the inbox. Archived threads
  // disappear from the default Inbox / At Risk / People views and only show
  // in the Archived view. Unarchive flips this back to null.
  archivedAt DateTime?

  // Set when the operator snoozes a thread. Threads with snoozedUntil in the
  // future are hidden from active views (Today / Inbox / At Risk) and
  // resurface automatically once the timestamp passes. Cleared on unsnooze.
  snoozedUntil DateTime?

  // Coarse classification: "outreach" (cold pitches, sales, recruitment,
  // marketing, InMails) vs "genuine" (peer chats, ongoing relationships).
  // Set by the AI service on first scan-time persist of a thread; null until
  // classified. Used by the Inbox filter dropdown to hide outreach noise.
  category String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  person       Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  messages     Message[]
  drafts       Draft[]
  sendRequests SendRequest[]

  @@unique([platform, platformThreadId])
  @@index([platform, riskLevel, needsReply, lastInboundAt])
  @@map("threads")
}

model Message {
  id                 String    @id @default(cuid())
  threadId           String
  platformMessageKey String
  direction          Direction
  timestamp          DateTime
  text               String
  senderName         String?
  rawJson            String?
  attachmentsJson    String?
  // Provenance for OUT messages. "automation" when send.ts (this runner)
  // wrote it. Null on inbound messages and on OUT messages that were only
  // observed via scan — those could have been sent from the LinkedIn web
  // UI directly, from another device, or from a previous version of this
  // system, so we cannot honestly claim "Sent via automation" for them.
  sentVia            String?
  /**
   * App-level threading: when the operator hits "Reply" in the dashboard
   * focused-thread view, we set this to the parent Message.id (cuid). The
   * message itself sends as a normal text bubble via the existing
   * AppleScript verb — no native iMessage thread linkage on the wire — so
   * the recipient on Messages.app sees a plain bubble. Dashboard users
   * see the threading because we render off this column (alongside the
   * Apple-native chat.db `thread_originator_guid` we stash on rawJson).
   *
   * Nullable: standalone messages and Apple-native replies (where the
   * parent is captured via rawJson.replyToGuid → platformMessageKey)
   * leave this null.
   */
  replyToMessageId   String?
  createdAt          DateTime  @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, platformMessageKey])
  @@index([threadId, timestamp])
  @@index([replyToMessageId])
  @@map("messages")
}

model Draft {
  id        String   @id @default(cuid())
  threadId  String
  text      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("drafts")
}

model AuditLog {
  id             String      @id @default(cuid())
  timestamp      DateTime    @default(now())
  platform       PlatformName?
  stage          String?
  action         String
  status         AuditStatus
  detailsJson    String?
  screenshotFile String?
  domDumpFile    String?

  @@index([timestamp, platform, action, status])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SendRequest {
  id           String            @id @default(cuid())
  clientSendId String            @unique
  threadId     String
  status       SendRequestStatus @default(PENDING)
  requestText  String
  // Set on scheduled sends. The promoter looks for SCHEDULED rows whose
  // scheduledFor has passed and flips them to PENDING so the regular
  // send-queue worker drains them. Null on rows that were sent immediately.
  scheduledFor DateTime?
  receiptJson  String?
  errorJson    String?
  // Outgoing attachments staged for this send. JSON array of
  // { absolutePath, displayName, mimeType, kind }. When the platform
  // adapter's sendMessage runs, it dispatches each file to the platform
  // (iMessage today; LinkedIn cap at text-only). Cleaned up by the send
  // worker after the row reaches SENT or FAILED.
  attachmentsJson String?
  /**
   * App-level threading: when the operator hits "Reply" in the dashboard
   * focused-thread view, the SendRequest carries the parent Message.id
   * (cuid). The send worker copies it onto the resulting Message row so
   * the dashboard renders the new bubble inline under its parent on the
   * next refresh. Null on regular standalone sends.
   */
  replyToMessageId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, status])
  @@index([status, scheduledFor])
  @@map("send_requests")
}
